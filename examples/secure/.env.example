# Copy to .env and fill in.

# Basic-auth credentials for the manager UI/API behind the proxy.
# Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
MANAGER_USER=admin
MANAGER_PASSWORD_HASH=

# Where the proxy listens on the host.
MANAGER_PORT=8080
MANAGER_ORIGIN=http://localhost:8080

# Tenant passwords, read by `apply` from this environment. Keep .env out of git.
ACME_DB_PASSWORD=
GLOBEX_DB_PASSWORD=
