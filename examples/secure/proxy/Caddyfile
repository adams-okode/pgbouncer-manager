# Authenticating reverse proxy for the manager.
#
# The whole site is protected, not just /api. The bundled SPA is served at /
# and is a thin client over the same unauthenticated API, so protecting only
# /api still hands the tenant list to anonymous visitors.
{
	admin off
	auto_https off
}

:8080 {
	basic_auth {
		{$MANAGER_USER} {$MANAGER_PASSWORD_HASH}
	}

	reverse_proxy manager:3000

	header {
		# The manager UI needs none of these; denying them costs nothing.
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}
